; Configuracao do FullServer. O nome do arquivo vem do nome do executavel:
; Config_<nome do exe>.ini, ao lado dele. Copie este arquivo para
; Config_RESTDWFullServer.ini e preencha o que for da sua maquina.
;
; Nada aqui vai versionado preenchido: credencial e caminho sao seus.
[BancoDados]
Servidor=Placa #0 - 127.0.0.1
DRIVER=0
USEDNS=0
BD=EMPLOYEE.FDB
; pasta onde esta o .fdb, com a barra final
Pasta=
PortaBD=3050
PortaDW=8082
UsuarioBD=
SenhaBD=
UsuarioDW=
SenhaDW=
DataSource=SQL
OsAuthent=0
MonitorBy=Remote
[Configs]
UPDLOG=1
ForceWelcomeAccess=0
[SSL]
PKF=
PKP=
CF=
HostCF=
