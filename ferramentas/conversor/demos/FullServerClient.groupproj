<Project xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
    <PropertyGroup>
        <ProjectGuid>{B4E0D5A7-91C6-4F3E-A0D2-6C71F8B94E55}</ProjectGuid>
    </PropertyGroup>
    <ItemGroup>
        <Projects Include="FullServer\RESTDWFullServer.dproj">
            <Dependencies/>
        </Projects>
        <Projects Include="FullClient\RESTDWFullClient.dproj">
            <Dependencies/>
        </Projects>
    </ItemGroup>
    <ProjectExtensions>
        <Borland.Personality>Default.Personality.12</Borland.Personality>
        <Borland.ProjectType/>
        <BorlandProject>
            <Default.Personality/>
        </BorlandProject>
    </ProjectExtensions>
    <Target Name="RESTDWFullServer">
        <MSBuild Projects="FullServer\RESTDWFullServer.dproj"/>
    </Target>
    <Target Name="RESTDWFullServer:Clean">
        <MSBuild Projects="FullServer\RESTDWFullServer.dproj" Targets="Clean"/>
    </Target>
    <Target Name="RESTDWFullServer:Make">
        <MSBuild Projects="FullServer\RESTDWFullServer.dproj" Targets="Make"/>
    </Target>
    <Target Name="RESTDWFullClient">
        <MSBuild Projects="FullClient\RESTDWFullClient.dproj"/>
    </Target>
    <Target Name="RESTDWFullClient:Clean">
        <MSBuild Projects="FullClient\RESTDWFullClient.dproj" Targets="Clean"/>
    </Target>
    <Target Name="RESTDWFullClient:Make">
        <MSBuild Projects="FullClient\RESTDWFullClient.dproj" Targets="Make"/>
    </Target>
    <Target Name="Build">
        <CallTarget Targets="RESTDWFullServer;RESTDWFullClient"/>
    </Target>
    <Target Name="Clean">
        <CallTarget Targets="RESTDWFullServer:Clean;RESTDWFullClient:Clean"/>
    </Target>
    <Target Name="Make">
        <CallTarget Targets="RESTDWFullServer:Make;RESTDWFullClient:Make"/>
    </Target>
    <Import Project="$(BDS)\Bin\CodeGear.Group.Targets" Condition="Exists('$(BDS)\Bin\CodeGear.Group.Targets')"/>
</Project>
