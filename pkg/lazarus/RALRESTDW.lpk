<?xml version="1.0" encoding="UTF-8"?>
<CONFIG>
  <Package Version="5">
    <PathDelim Value="\"/>
    <Name Value="RALRESTDW"/>
    <Type Value="RunTime"/>
    <CompilerOptions>
      <Version Value="11"/>
      <PathDelim Value="\"/>
      <SearchPaths>
        <OtherUnitFiles Value="..\..\src"/>
        <UnitOutputDirectory Value="lib\$(TargetCPU)-$(TargetOS)"/>
      </SearchPaths>
      <Linking>
        <Debugging>
          <DebugInfoType Value="dsDwarf3"/>
        </Debugging>
      </Linking>
    </CompilerOptions>
    <Files>
      <Item>
        <Filename Value="..\..\src\RALRESTDWModule.pas"/>
        <UnitName Value="RALRESTDWModule"/>
      </Item>
      <Item>
        <Filename Value="..\..\src\RALRESTDWParams.pas"/>
        <UnitName Value="RALRESTDWParams"/>
      </Item>
      <Item>
        <Filename Value="..\..\src\RALRESTDWParamsMethods.pas"/>
        <UnitName Value="RALRESTDWParamsMethods"/>
      </Item>
      <Item>
        <Filename Value="..\..\src\RALRESTDWServerEvents.pas"/>
        <UnitName Value="RALRESTDWServerEvents"/>
      </Item>
      <Item>
        <Filename Value="..\..\src\RALRESTDWTypes.pas"/>
        <UnitName Value="RALRESTDWTypes"/>
      </Item>
      <Item>
        <Filename Value="..\..\src\RALRESTDWClientEvents.pas"/>
        <UnitName Value="RALRESTDWClientEvents"/>
      </Item>
      <Item>
        <Filename Value="..\..\src\RALRESTDWEvents.pas"/>
        <UnitName Value="RALRESTDWEvents"/>
      </Item>
      <Item>
        <Filename Value="..\..\src\RALRESTDWCompat.pas"/>
        <UnitName Value="RALRESTDWCompat"/>
      </Item>
      <Item>
        <Filename Value="..\..\src\RALRESTDWOptions.pas"/>
        <UnitName Value="RALRESTDWOptions"/>
      </Item>
      <Item>
        <Filename Value="..\..\src\RALRESTDWDataModule.pas"/>
        <UnitName Value="RALRESTDWDataModule"/>
      </Item>
      <Item>
        <Filename Value="..\..\src\RALRESTDWClient.pas"/>
        <UnitName Value="RALRESTDWClient"/>
      </Item>
      <Item>
        <Filename Value="..\..\src\RALRESTDWMassive.pas"/>
        <UnitName Value="RALRESTDWMassive"/>
      </Item>
      <Item>
        <Filename Value="..\..\src\RALRESTDWServerContext.pas"/>
        <UnitName Value="RALRESTDWServerContext"/>
      </Item>
    </Files>
    <RequiredPkgs>
      <Item>
        <PackageName Value="PascalRAL"/>
      </Item>
      <Item>
        <PackageName Value="FCL"/>
      </Item>
    </RequiredPkgs>
    <UsageOptions>
      <UnitPath Value="$(PkgOutDir)"/>
    </UsageOptions>
    <PublishOptions>
      <Version Value="2"/>
      <UseFileFilters Value="True"/>
    </PublishOptions>
  </Package>
</CONFIG>
