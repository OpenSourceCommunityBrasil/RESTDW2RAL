package RALRESTDW;

{$R *.res}
{$R 'RALRESTDW.dcr'}
{$IFDEF IMPLICITBUILDING This IFDEF should not be used by users}
{$ALIGN 8}
{$ASSERTIONS ON}
{$BOOLEVAL OFF}
{$DEBUGINFO OFF}
{$EXTENDEDSYNTAX ON}
{$IMPORTEDDATA ON}
{$IOCHECKS ON}
{$LOCALSYMBOLS ON}
{$LONGSTRINGS ON}
{$OPENSTRINGS ON}
{$OPTIMIZATION OFF}
{$OVERFLOWCHECKS ON}
{$RANGECHECKS ON}
{$REFERENCEINFO ON}
{$SAFEDIVIDE OFF}
{$STACKFRAMES ON}
{$TYPEDADDRESS OFF}
{$VARSTRINGCHECKS ON}
{$WRITEABLECONST OFF}
{$MINENUMSIZE 1}
{$IMAGEBASE $400000}
{$DEFINE DEBUG}
{$ENDIF IMPLICITBUILDING}
{$IMPLICITBUILD ON}

requires
  rtl,
  PascalRALDsgn;

contains
  RALRESTDWModule in '..\..\src\RALRESTDWModule.pas',
  RALRESTDWParams in '..\..\src\RALRESTDWParams.pas',
  RALRESTDWParamsMethods in '..\..\src\RALRESTDWParamsMethods.pas',
  RALRESTDWReg in '..\..\src\RALRESTDWReg.pas',
  RALRESTDWServerEvents in '..\..\src\RALRESTDWServerEvents.pas',
  RALRESTDWTypes in '..\..\src\RALRESTDWTypes.pas',
  RALRESTDWClientEvents in '..\..\src\RALRESTDWClientEvents.pas',
  RALRESTDWEvents in '..\..\src\RALRESTDWEvents.pas',
  RALRESTDWCompat in '..\..\src\RALRESTDWCompat.pas';

end.
